# build artifacts
/energy-schema/energy-schema
/energy-schema/*.exe
/build/
*.log
.DS_Store

# IDE
/.idea/

# local deploy secrets (host/password/key/slug) — NEVER commit (public repo)
/deploy.local.mk
/coverage.out

# graphify (rebuilt by post-commit hook) — any depth, incl. energy-schema/graphify-out/
graphify-out/

# battery evidence exports (private data, not for the public repo)
evidence/

# ad-hoc HA debug helpers run via `make remote-sh` — not for the public repo.
# Already-tracked ha_*.sh stay tracked; new ones are local by default (git add -f to keep).
scripts/ha_*.sh
